# Address from `forge script script/Deploy.s.sol --rpc-url bsc_testnet --broadcast`
NEXT_PUBLIC_CONTRACT_ADDRESS=
# Optional public RPC override (the default is BNB Chain Testnet public RPC)
NEXT_PUBLIC_BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
# Server only. Create a Pinata JWT with pinning permissions; never expose it as NEXT_PUBLIC_*
PINATA_JWT=
